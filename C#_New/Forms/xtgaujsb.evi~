        }

        private void ExportAssignments_Click(object sender, EventArgs e)
        {
            using (var saveDialog = new SaveFileDialog())
            {
                saveDialog.Filter = "CSV Files (*.csv)|*.csv|Text Files (*.txt)|*.txt";
                saveDialog.FileName = $"Assignments_{DateTime.Now:yyyyMMdd}.csv";

                if (saveDialog.ShowDialog() == DialogResult.OK)
                {
                    try
                    {
                        var assignments = _assignmentRepo.GetAssignmentsByStudent(_currentStudent.StudentId);
                        var sb = new StringBuilder();
                        sb.AppendLine("Course,Title,Description,Due Date,Priority,Status");

                        foreach (var assignment in assignments)
                        {
                            sb.AppendLine($"\"{assignment.Course.CourseName}\"," +
                                $"\"{assignment.Title}\"," +
                                $"\"{assignment.Description}\"," +
                                $"{assignment.DueDate:yyyy-MM-dd HH:mm}," +
                                $"{assignment.Priority}," +
                                $"{assignment.Status}");
                        }

                        File.WriteAllText(saveDialog.FileName, sb.ToString());
                        MessageBox.Show("Assignments exported successfully!", "Export Complete",
                            MessageBoxButtons.OK, MessageBoxIcon.Information);
                    }
                    catch (Exception ex)
                    {
                        MessageBox.Show($"Error exporting: {ex.Message}", "Export Error",
                            MessageBoxButtons.OK, MessageBoxIcon.Error);
                    }
                }
            }
        }

        private void StartReminderTimer()
        {
            reminderTimer = new Timer();
            reminderTimer.Interval = 3600000; // Check every hour
            reminderTimer.Tick += CheckReminders;
            reminderTimer.Start();
            CheckReminders(null, null); // Check immediately
        }

        private void CheckReminders(object sender, EventArgs e)
        {
            var upcomingAssignments = _assignmentRepo.GetUpcomingAssignments(_currentStudent.StudentId, 1);

            foreach (var assignment in upcomingAssignments)
            {
                var timeUntilDue = assignment.DueDate - DateTime.Now;
                if (timeUntilDue.TotalHours <= 24 && timeUntilDue.TotalHours > 0)
                {
                    MessageBox.Show(
                        $"Reminder: '{assignment.Title}' in {assignment.Course.CourseName}\n" +
                        $"is due in {timeUntilDue.Hours} hours!",
                        "Assignment Due Soon",
                        MessageBoxButtons.OK,
                        MessageBoxIcon.Information);
                }
            }
        }

