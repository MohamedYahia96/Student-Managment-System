        private void LoadCourses()
        {
            lstCourses.Items.Clear();
            var courses = _courseRepo.GetCoursesByStudent(_currentStudent.StudentId);

            foreach (var course in courses)
            {
                lstCourses.Items.Add(new CourseListItem
                {
                    CourseId = course.CourseId,
                    DisplayText = $"{course.CourseCode} - {course.CourseName}"
                });
            }
        }

        private void LoadAllAssignments()
        {
            var assignments = _assignmentRepo.GetAssignmentsByStudent(_currentStudent.StudentId);

            var displayData = assignments.Select(a => new
            {
                AssignmentId = a.AssignmentId,
                Course = a.Course.CourseName,
                Title = a.Title,
                DueDate = a.DueDate.ToString("MM/dd/yyyy hh:mm tt"),
                Priority = a.Priority,
                Status = a.Status
            }).ToList();

            dgvAllAssignments.DataSource = displayData;

            if (dgvAllAssignments.Columns["AssignmentId"] != null)
                dgvAllAssignments.Columns["AssignmentId"].Visible = false;

            // Color coding
            foreach (DataGridViewRow row in dgvAllAssignments.Rows)
            {
                var priority = row.Cells["Priority"].Value?.ToString();
                var status = row.Cells["Status"].Value?.ToString();

                if (status == "Complete")
                {
                    row.DefaultCellStyle.BackColor = Color.LightGreen;
                }
                else if (status == "Overdue")
                {
                    row.DefaultCellStyle.BackColor = Color.LightCoral;
                }
                else
                {
                    switch (priority)
                    {
                        case "High":
                            row.DefaultCellStyle.BackColor = Color.MistyRose;
                            break;
                        case "Medium":
                            row.DefaultCellStyle.BackColor = Color.LightYellow;
                            break;
                        case "Low":
                            row.DefaultCellStyle.BackColor = Color.LightBlue;
                            break;
                    }
                }
            }
        }

        public void RefreshAll()
        {
            LoadCourses();
            LoadAllAssignments();

            foreach (Form childForm in this.MdiChildren)
            {
                if (childForm is CourseForm courseForm)
                {
                    courseForm.RefreshData();
                }
            }
        }

        private void NewCourse_Click(object sender, EventArgs e)
        {
            var addCourseForm = new AddEditCourseForm(_currentStudent);
            if (addCourseForm.ShowDialog() == DialogResult.OK)
            {
                RefreshAll();
            }
        }

        private void EditCourse_Click(object sender, EventArgs e)
        {
            if (lstCourses.SelectedItem is CourseListItem selectedItem)
            {
                var course = _courseRepo.GetById(selectedItem.CourseId);
                var editForm = new AddEditCourseForm(_currentStudent, course);
                if (editForm.ShowDialog() == DialogResult.OK)
                {
                    RefreshAll();
                }
            }
            else
            {
                MessageBox.Show("Please select a course to edit.", "No Selection",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

        private void DeleteCourse_Click(object sender, EventArgs e)
        {
            if (lstCourses.SelectedItem is CourseListItem selectedItem)
            {
                var result = MessageBox.Show(
                    "Are you sure you want to delete this course?\nAll assignments will also be deleted.",
                    "Confirm Delete",
                    MessageBoxButtons.YesNo,
                    MessageBoxIcon.Warning);

                if (result == DialogResult.Yes)
                {
                    _courseRepo.Delete(selectedItem.CourseId);
                    _courseRepo.Save();
                    RefreshAll();
                    MessageBox.Show("Course deleted successfully.", "Success",
                        MessageBoxButtons.OK, MessageBoxIcon.Information);
                }
            }
            else
            {
                MessageBox.Show("Please select a course to delete.", "No Selection",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
            }
        }

        private void LstCourses_DoubleClick(object sender, EventArgs e)
        {
            if (lstCourses.SelectedItem is CourseListItem selectedItem)
            {
                var course = _courseRepo.GetById(selectedItem.CourseId);
                var editForm = new AddEditCourseForm(_currentStudent, course);
                if (editForm.ShowDialog() == DialogResult.OK)
                {
                    RefreshAll();
                }
            }
        }

        private void DgvAllAssignments_DoubleClick(object sender, EventArgs e)
        {
            if (dgvAllAssignments.SelectedRows.Count > 0)
            {
                var assignmentId = (int)dgvAllAssignments.SelectedRows[0].Cells["AssignmentId"].Value;
                var assignment = _assignmentRepo.GetById(assignmentId);
                var course = _courseRepo.GetById(assignment.CourseId);

                var editForm = new AddEditAssignmentForm(course, assignment);
                if (editForm.ShowDialog() == DialogResult.OK)
                {
                    RefreshAll();
                }
            }
        }

