using System;
using System.Drawing;
using System.Windows.Forms;
using StudentAssignmentManager.Data;
using StudentAssignmentManager.Models;
using StudentAssignmentManager.Repositories;

namespace StudentAssignmentManager.Forms
{
    public partial class AddEditCourseForm : Form
    {
        private Student _currentStudent;
        private Course _editingCourse;
        private bool _isEditMode;
        private StudentSystemDbContext _context;
        private CourseRepository _courseRepo;

        private TextBox txtCourseName;
        private TextBox txtCourseCode;
        private TextBox txtInstructor;
        private TextBox txtCredits;
        private TextBox txtSchedule;
        private RichTextBox rtbNotes;
        private Button btnSave;
        private Button btnCancel;

        public AddEditCourseForm(Student student, Course course = null)
        {
            _currentStudent = student;
            _editingCourse = course;
            _isEditMode = course != null;
            _context = new StudentSystemDbContext();
            _courseRepo = new CourseRepository(_context);

            InitializeComponent();

            if (_isEditMode)
            {
                LoadCourseData();
            }
        }

        private void InitializeComponent()
        {
            this.Text = _isEditMode ? "Edit Course" : "Add New Course";
            this.Size = new Size(600, 500);
            this.StartPosition = FormStartPosition.CenterParent;
            this.FormBorderStyle = FormBorderStyle.FixedDialog;
            this.MaximizeBox = false;

            // Course Name
            var lblCourseName = new Label
            {
                Text = "Course Name:",
                Location = new Point(20, 20),
                Size = new Size(100, 20)
            };

            txtCourseName = new TextBox
            {
                Location = new Point(130, 18),
                Size = new Size(420, 25)
            };

            // Course Code
            var lblCourseCode = new Label
            {
                Text = "Course Code:",
                Location = new Point(20, 60),
                Size = new Size(100, 20)
            };

            txtCourseCode = new TextBox
            {
                Location = new Point(130, 58),
                Size = new Size(150, 25)
            };

            // Instructor
            var lblInstructor = new Label
            {
                Text = "Instructor:",
                Location = new Point(20, 100),
                Size = new Size(100, 20)
            };

            txtInstructor = new TextBox
            {
                Location = new Point(130, 98),
                Size = new Size(300, 25)
            };

            // Credits
            var lblCredits = new Label
            {
                Text = "Credits:",
                Location = new Point(20, 140),
                Size = new Size(100, 20)
            };

            txtCredits = new TextBox
            {
                Location = new Point(130, 138),
                Size = new Size(80, 25)
            };

            // Schedule
            var lblSchedule = new Label
            {
                Text = "Schedule:",
                Location = new Point(20, 180),
                Size = new Size(100, 20)
            };

            txtSchedule = new TextBox
            {
                Location = new Point(130, 178),
                Size = new Size(300, 25),
                PlaceholderText = "e.g., MWF 10:00-11:00 AM"
            };

            // Notes
            var lblNotes = new Label
            {
                Text = "Notes:",
                Location = new Point(20, 220),
                Size = new Size(100, 20)
            };

            rtbNotes = new RichTextBox
            {
                Location = new Point(130, 218),
                Size = new Size(420, 150)
            };

            // Buttons
            btnSave = new Button
            {
                Text = "💾 Save",
                Location = new Point(350, 390),
                Size = new Size(100, 35)
            };
            btnSave.Click += BtnSave_Click;

            btnCancel = new Button
            {
                Text = "❌ Cancel",
                Location = new Point(460, 390),
                Size = new Size(100, 35)
            };
            btnCancel.Click += (s, e) => this.Close();

            // Add all controls
            this.Controls.Add(lblCourseName);
            this.Controls.Add(txtCourseName);
            this.Controls.Add(lblCourseCode);
            this.Controls.Add(txtCourseCode);
            this.Controls.Add(lblInstructor);
            this.Controls.Add(txtInstructor);
            this.Controls.Add(lblCredits);
            this.Controls.Add(txtCredits);
            this.Controls.Add(lblSchedule);
            this.Controls.Add(txtSchedule);
            this.Controls.Add(lblNotes);
            this.Controls.Add(rtbNotes);
            this.Controls.Add(btnSave);
            this.Controls.Add(btnCancel);
        }

        private void LoadCourseData()
        {
            txtCourseName.Text = _editingCourse.CourseName;
            txtCourseCode.Text = _editingCourse.CourseCode;
            txtInstructor.Text = _editingCourse.Instructor;
            txtCredits.Text = _editingCourse.Credits?.ToString() ?? "";
            txtSchedule.Text = _editingCourse.Schedule;
            rtbNotes.Text = _editingCourse.Notes;
        }

        private void BtnSave_Click(object sender, EventArgs e)
        {
            // Validation
            if (string.IsNullOrWhiteSpace(txtCourseName.Text))
            {
                MessageBox.Show("Please enter a course name.", "Validation Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Warning);
                return;
            }

            int credits = 0;
            if (!string.IsNullOrWhiteSpace(txtCredits.Text))
            {
                if (!int.TryParse(txtCredits.Text, out credits))
                {
                    MessageBox.Show("Credits must be a valid number.", "Validation Error",
                        MessageBoxButtons.OK, MessageBoxIcon.Warning);
                    return;
                }
            }

            try
            {
                if (_isEditMode)
                {
                    // Update existing course
                    _editingCourse.CourseName = txtCourseName.Text;
                    _editingCourse.CourseCode = txtCourseCode.Text;
                    _editingCourse.Instructor = txtInstructor.Text;
                    _editingCourse.Credits = credits > 0 ? credits : (int?)null;
                    _editingCourse.Schedule = txtSchedule.Text;
                    _editingCourse.Notes = rtbNotes.Text;

                    _courseRepo.Update(_editingCourse);
                }
                else
                {
                    // Add new course
                    var newCourse = new Course
                    {
                        CourseName = txtCourseName.Text,
                        CourseCode = txtCourseCode.Text,
                        Instructor = txtInstructor.Text,
                        Credits = credits > 0 ? credits : (int?)null,
                        Schedule = txtSchedule.Text,
                        Notes = rtbNotes.Text,
                        StudentId = _currentStudent.StudentId,
                        CreatedDate = DateTime.Now
                    };

                    _courseRepo.Add(newCourse);
                }

                _courseRepo.Save();

                MessageBox.Show("Course saved successfully!", "Success",
                    MessageBoxButtons.OK, MessageBoxIcon.Information);

                this.DialogResult = DialogResult.OK;
                this.Close();
            }
            catch (Exception ex)
            {
                MessageBox.Show($"Error saving course: {ex.Message}", "Error",
                    MessageBoxButtons.OK, MessageBoxIcon.Error);
            }
        }

        protected override void OnFormClosing(FormClosingEventArgs e)
        {
            _context?.Dispose();
            base.OnFormClosing(e);
        }
    }
}