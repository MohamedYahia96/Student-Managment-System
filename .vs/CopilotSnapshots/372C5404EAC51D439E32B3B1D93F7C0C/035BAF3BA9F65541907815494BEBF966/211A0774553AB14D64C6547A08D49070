        private void LoadCourses()
        {
            var courses = _courseRepo.GetCoursesByStudent(_currentStudent.StudentId);
            foreach (var course in courses)
            {
                clbCourses.Items.Add(new CourseCheckItem
                {
                    CourseId = course.CourseId,
                    CourseName = $"{course.CourseCode} - {course.CourseName}"
                }, true);
            }
        }

        private void DateFilter_CheckedChanged(object sender, EventArgs e)
        {
            dtpFrom.Enabled = rbCustomRange.Checked;
            dtpTo.Enabled = rbCustomRange.Checked;
        }

        private void BtnSearch_Click(object sender, EventArgs e)
        {
            PerformSearch();
        }

        private void PerformSearch()
        {
            string searchTerm = txtSearchKeyword.Text;

            // Get selected priorities
            var priorities = new List<string>();
            if (chkHigh.Checked) priorities.Add("High");
            if (chkMedium.Checked) priorities.Add("Medium");
            if (chkLow.Checked) priorities.Add("Low");

            // Get selected statuses
            var statuses = new List<string>();
            if (chkPending.Checked) statuses.Add("Pending");
            if (chkInProgress.Checked) statuses.Add("In Progress");
            if (chkComplete.Checked) statuses.Add("Complete");
            if (chkOverdue.Checked) statuses.Add("Overdue");

            // Get date range
            DateTime? startDate = null;
            DateTime? endDate = null;

            if (rbThisWeek.Checked)
            {
                startDate = DateTime.Now;
                endDate = DateTime.Now.AddDays(7);
            }
            else if (rbThisMonth.Checked)
            {
                startDate = DateTime.Now;
                endDate = DateTime.Now.AddMonths(1);
            }
            else if (rbOverdueOnly.Checked)
            {
                endDate = DateTime.Now;
            }
            else if (rbCustomRange.Checked)
            {
                startDate = dtpFrom.Value.Date;
                endDate = dtpTo.Value.Date.AddDays(1).AddSeconds(-1);
            }

            // Perform search
            var results = _assignmentRepo.SearchAssignments(
                _currentStudent.StudentId,
                searchTerm,
                priorities.Any() ? priorities : null,
                statuses.Any() ? statuses : null,
                startDate,
                endDate
            );

            // Filter by selected courses
            var selectedCourseIds = clbCourses.CheckedItems
                .Cast<CourseCheckItem>()
                .Select(c => c.CourseId)
                .ToList();

            if (selectedCourseIds.Any())
            {
                results = results.Where(a => selectedCourseIds.Contains(a.CourseId)).ToList();
            }

            // Display results
            var displayData = results.Select(a => new
            {
                AssignmentId = a.AssignmentId,
                Course = a.Course.CourseName,
                Title = a.Title,
                Description = a.Description,
                DueDate = a.DueDate.ToString("MM/dd/yyyy hh:mm tt"),
                Priority = a.Priority,
                Status = a.Status
            }).ToList();

            dgvResults.DataSource = displayData;

            if (dgvResults.Columns["AssignmentId"] != null)
                dgvResults.Columns["AssignmentId"].Visible = false;

            // Color coding
            foreach (DataGridViewRow row in dgvResults.Rows)
            {
                var priority = row.Cells["Priority"].Value?.ToString();
                var status = row.Cells["Status"].Value?.ToString();

                if (status == "Complete")
                {
                    row.DefaultCellStyle.BackColor = Color.LightGreen;
                }
                else if (status == "Overdue")
                {
                    row.DefaultCellStyle.BackColor = Color.LightCoral;
                }
                else
                {
                    switch (priority)
                    {
                        case "High":
                            row.DefaultCellStyle.BackColor = Color.MistyRose;
                            break;
                        case "Medium":
                            row.DefaultCellStyle.BackColor = Color.LightYellow;
                            break;
                        case "Low":
                            row.DefaultCellStyle.BackColor = Color.LightBlue;
                            break;
                    }
                }
            }

            // Update status
            var lblResultCount = new Label
            {
                Text = $"Found {results.Count()} assignment(s)",
                Location = new Point(800, 462),
                Size = new Size(150, 20)
            };
            this.Controls.Add(lblResultCount);
        }

        private void BtnClearAll_Click(object sender, EventArgs e)
        {
            txtSearchKeyword.Clear();

            for (int i = 0; i < clbCourses.Items.Count; i++)
            {
                clbCourses.SetItemChecked(i, true);
            }

            chkHigh.Checked = true;
            chkMedium.Checked = true;
            chkLow.Checked = true;
            chkPending.Checked = true;
            chkInProgress.Checked = true;
            chkComplete.Checked = true;
            chkOverdue.Checked = true;

            rbAll.Checked = true;

            dgvResults.DataSource = null;
        }

        private void DgvResults_DoubleClick(object sender, EventArgs e)
        {
            if (dgvResults.SelectedRows.Count > 0)
            {
                var assignmentId = (int)dgvResults.SelectedRows[0].Cells["AssignmentId"].Value;
                var assignment = _assignmentRepo.GetById(assignmentId);
                var course = _courseRepo.GetById(assignment.CourseId);

                var editForm = new AddEditAssignmentForm(course, assignment);
                if (editForm.ShowDialog() == DialogResult.OK)
                {
                    PerformSearch();
                    _parentDashboard?.RefreshAll();
                }
            }
        }

