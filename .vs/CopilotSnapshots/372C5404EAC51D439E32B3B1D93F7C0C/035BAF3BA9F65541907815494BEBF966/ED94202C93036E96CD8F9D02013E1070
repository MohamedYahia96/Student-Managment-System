            rtbNotes.Text = _course.Notes;
        }

        private void LoadAssignments()
        {
            var assignments = _assignmentRepo.GetAssignmentsByCourse(_course.CourseId);

            var displayData = assignments.Select(a => new
            {
                AssignmentId = a.AssignmentId,
                Title = a.Title,
                DueDate = a.DueDate.ToString("MM/dd/yyyy hh:mm tt"),
                Priority = a.Priority,
                Status = a.Status
            }).ToList();

            dgvAssignments.DataSource = displayData;

            if (dgvAssignments.Columns["AssignmentId"] != null)
                dgvAssignments.Columns["AssignmentId"].Visible = false;

            // Color coding
            foreach (DataGridViewRow row in dgvAssignments.Rows)
            {
                var priority = row.Cells["Priority"].Value?.ToString();
                var status = row.Cells["Status"].Value?.ToString();

                if (status == "Complete")
                {
                    row.DefaultCellStyle.BackColor = Color.LightGreen;
                }
                else if (status == "Overdue")
                {
                    row.DefaultCellStyle.BackColor = Color.LightCoral;
                }
                else
                {
                    switch (priority)
                    {
                        case "High":
                            row.DefaultCellStyle.BackColor = Color.MistyRose;
                            break;
                        case "Medium":
                            row.DefaultCellStyle.BackColor = Color.LightYellow;
                            break;
                        case "Low":
                            row.DefaultCellStyle.BackColor = Color.LightBlue;
                            break;
                    }
                }
            }
        }

        public void RefreshData()
        {
